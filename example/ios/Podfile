# React Native’s pods bootstrap script (`react_native_pods.rb`) shells out to Node a few times:
#   1. To locate the CLI and codegen helpers that live inside `node_modules`.
#   2. During pod install, to generate FBReactNativeSpec headers.
#   3. Inside Xcode build phases, to regenerate those headers.
# If `pod install` is run with a different Node runtime than Xcode uses (via `.xcode.env`),
# the generated headers will disappear and compilation will fail with “Cannot find protocol declaration”.
# The helper below always resolves the **same** Node binary that Xcode will later source so that
# pod install, Xcode builds, and CI all agree on the runtime.
# Keep this example on the legacy RCTBridgeModule architecture by design.
ENV['RCT_NEW_ARCH_ENABLED'] = '0'

# Resolve react_native_pods.rb with node to allow for hoisting
def resolve_node_binary
  def valid_node_path?(path)
    path && !path.empty? && File.exist?(path)
  end

  def node_from_env_file(path)
    return nil unless File.exist?(path)
    File.readlines(path).each do |line|
      match = line.match(/export\s+NODE_BINARY=(.+)/)
      next unless match
      candidate = match[1].strip.delete('"')
      return candidate if candidate && !candidate.empty? && File.exist?(candidate)
    end
    nil
  end

  # 1. Respect project-local overrides first.
  candidate = node_from_env_file(File.expand_path('.xcode.env.local', __dir__))
  return candidate if valid_node_path?(candidate)

  # 2. Fall back to the tracked .xcode.env file.
  candidate = node_from_env_file(File.expand_path('.xcode.env', __dir__))
  return candidate if valid_node_path?(candidate)

  # 3. Allow explicit overrides via NODE_BINARY in the shell environment.
  candidate = ENV['NODE_BINARY']
  return candidate if valid_node_path?(candidate)

  # 4. Finally, rely on PATH.
  candidate = `sh -c "command -v node"`.strip
  return candidate if valid_node_path?(candidate)

  raise "Unable to locate node binary. Set NODE_BINARY in .xcode.env or export NODE_BINARY before running pod install."
end

node_binary = resolve_node_binary
ENV['NODE_BINARY'] = node_binary
# Ensure any subsequent `command -v node` resolves to the same binary, even if other shells prefer a different version.
node_dir = File.dirname(node_binary)
path_entries = ENV['PATH'].to_s.split(File::PATH_SEPARATOR)
unless path_entries.first == node_dir
  ENV['PATH'] = ([node_dir] + path_entries).uniq.join(File::PATH_SEPARATOR)
end
require Pod::Executable.execute_command(node_binary, ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

require 'pathname'

class ::ReactNativePodsUtils
  class << self
    if method_defined?(:create_xcode_env_if_missing)
      alias_method :_native_video_original_create_xcode_env_if_missing, :create_xcode_env_if_missing
    end

    def create_xcode_env_if_missing(file_manager: File)
      node_path = ENV['NODE_BINARY'] || `sh -c "command -v node"`.strip
      if node_path.empty?
        raise "Unable to locate node binary. Set NODE_BINARY to a valid path."
      end

      relative_path = Pod::Config.instance.installation_root.relative_path_from(Pathname.pwd)
      env_path = file_manager.join(relative_path, '.xcode.env')
      local_env_path = "#{env_path}.local"
      ensure_node_env_file(file_manager, env_path, node_path)
      ensure_node_env_file(file_manager, local_env_path, node_path)

      if defined?(_native_video_original_create_xcode_env_if_missing)
        _native_video_original_create_xcode_env_if_missing(file_manager: file_manager)
      end
    end

    private

    def ensure_node_env_file(file_manager, path, node_path)
      desired = "export NODE_BINARY=#{node_path}\n"
      current = file_manager.exist?(path) ? file_manager.read(path) : nil

      # Leave any existing .xcode.env* files alone so developers fully control their runtime.
      if file_manager.exist?(path) && File.basename(path).start_with?('.xcode.env')
        return
      end

      return if current == desired

      file_manager.write(path, desired)
    end
  end
end

platform :ios, min_ios_version_supported
project 'NativeVideoExample.xcodeproj'
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'NativeVideoExample' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'NativeVideoExampleTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
