{
  "name": "react-native-native-video",
  "version": "0.2.23",
  "description": "Native Video Access for React Native",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.tsx",
  "source": "src/index.tsx",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "react-native-native-video.podspec",
    "RETROZERO_RESURRECTION.md",
    "!android/build",
    "!android/.cxx",
    "!android/.gradle",
    "!ios/build"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prepare": "bob build",
    "example": "yarn --cwd example",
    "example:android": "yarn --cwd example android",
    "example:ios": "yarn --cwd example ios",
    "example:start": "yarn --cwd example start"
  },
  "keywords": [
    "react-native",
    "jsi",
    "video",
    "ios",
    "android"
  ],
  "repository": "https://github.com/swittk/react-native-native-video",
  "author": "Switt Kongdachalert <swittssoftware@gmail.com> (https://swittssoftware.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/swittk/react-native-native-video/issues"
  },
  "homepage": "https://github.com/swittk/react-native-native-video#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-builder-bob": "^0.43.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-native": ">=0.64.3"
  },
  "codegenConfig": {
    "name": "RNNativeVideoSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.reactnativenativevideo"
    },
    "ios": {
      "modulesProvider": {
        "NativeVideo": "NativeVideo"
      }
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
